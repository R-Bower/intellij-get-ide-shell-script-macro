<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="false">
  <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
  <id>com.rbower.intellij-get-shell-script-plugin</id>

  <!-- Public plugin name should be written in Title Case.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
  <name>Shell Script Macro</name>

  <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
  <vendor>Ryan Bower</vendor>

  <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
  <description><![CDATA[
        Provides a <code>$ToolboxShellScript$</code> macro that resolves the absolute path to the
        JetBrains Toolbox shell script for the currently running IDE.<br><br>
        Use it in External Tools, Run Configurations, or anywhere IntelliJ macros are supported
        to launch the current IDE from the command line via its Toolbox-managed shell script.<br><br>
        Supports macOS, Linux, and Windows.
    ]]></description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <macro implementation="com.rbower.macros.ToolboxShellScriptMacro"/>
  </extensions>
</idea-plugin>